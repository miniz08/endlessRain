erDiagram
  USER ||--o{ AUTH_REFRESH_TOKEN : owns
  USER ||--o{ AUDIT_LOG : writes

  USER {
    int id PK
    varchar username UK
    varchar email UK
    varchar password
    varchar avatar
    varchar bio
    varchar role
    int professionalism
    int friendliness
    datetime createdAt
    datetime updatedAt
  }

  AUTH_REFRESH_TOKEN {
    bigint id PK
    int userId FK
    char tokenHash UK
    char csrfToken
    datetime expiresAt
    datetime createdAt
    datetime revokedAt
    char replacedByTokenHash
    varchar userAgent
    varchar ipAddress
  }

  AUDIT_LOG {
    bigint id PK
    varchar requestId
    int userId
    varchar username
    varchar role
    varchar method
    varchar route
    varchar action
    varchar result
    int statusCode
    datetime createdAt
  }

