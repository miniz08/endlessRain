flowchart TD
  A["请求进入api网关"] --> B["生成requestId"]
  B --> C["请求转发到业务服务"]
  C --> D["业务服务执行操作"]
  D --> E{"成功或失败"}
  E -- 成功 --> F["写入success审计日志"]
  E -- 失败 --> G["写入failure审计日志"]
  F --> H["审计日志数据表"]
  G --> H
  H --> I["管理员访问"]
  I --> J["网关校验"]
  J --> K["查询审计日志与运行摘要"]
  K --> L["展示健康状态、指标、失败请求"]

