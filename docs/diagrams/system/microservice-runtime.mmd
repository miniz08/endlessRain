    AiService["ai_service<br/>AI 内容评分与标签"]
    ChatService["chat_service<br/>私信与 WebSocket"]
  end

  subgraph Data["共享数据层"]
    MySQL[("MySQL<br/>业务数据与审计数据")]
  end

  subgraph External["外部模型服务"]
    AiProvider["OpenAI-compatible Provider<br/>或 Mock Provider"]
  end

