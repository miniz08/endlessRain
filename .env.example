# Longseason AI social platform Docker environment template.
# Copy this file to .env for Docker Compose. The real .env is ignored by Git.

# MySQL database used by all services. Replace this line in .env if the database changes.
DATABASE_URL="mysql://user:password@host:3306/longseason"

# Development tokens. They are intentionally readable for simple deployment.
# Change them before a public production deployment.
ACCESS_TOKEN_SECRET="longseason-dev-access-token-secret"
JWT_SECRET="longseason-dev-access-token-secret"
AI_INTERNAL_TOKEN="longseason-dev-ai-internal-token"

# Internal Docker service URLs. These are container-network addresses, not public URLs.
USER_SERVICE_URL="http://user_service:3003"
BLOG_SERVICE_URL="http://blog_service:3002"
AI_SERVICE_URL="http://ai_service:3004"
CHAT_SERVICE_URL="http://chat_service:3005"

# AI provider.
# mock: stable offline defense/demo mode, no API key needed.
# openai-compatible: call a real mainland-accessible OpenAI-compatible provider.
AI_PROVIDER="mock"
AI_BASE_URL="https://api.siliconflow.cn/v1"
AI_CHAT_PATH="/chat/completions"
AI_API_KEY=""
AI_MODEL="Qwen/QwQ-32B"
AI_TIMEOUT_MS=20000
AI_RETRY_COUNT=1
AI_ANALYSIS_ON_CREATE="true"

# Frontend runtime paths.
NUXT_PUBLIC_API_BASE="/api"
NUXT_PUBLIC_WS_BASE=""

# Cookie policy for auth.
# Keep COOKIE_SECURE=false when the site is served over plain http://IP:PORT.
# Set COOKIE_SECURE=true only after enabling HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Uploaded media. Production keeps files under the cloud host root path:
# 106.52.220.73:/media/img/uni, then serves them as /media/img/uni/...
MEDIA_HOST_DIR="/media/img/uni"
MEDIA_PUBLIC_BASE="/media/img/uni"
MEDIA_IMAGE_MAX_BYTES=2097152
MEDIA_SMALL_IMAGE_MAX_BYTES=102400

# Production host port. Container frontend still listens on 80.
FRONTEND_HTTP_PORT=800

# Docker development host ports. Container ports stay as 3000-3005.
DEV_FRONTEND_PORT=13000
DEV_GATEWAY_PORT=13001
DEV_BLOG_PORT=13002
DEV_USER_PORT=13003
DEV_AI_PORT=13004
DEV_CHAT_PORT=13005
