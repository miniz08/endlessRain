PORT=3002
DATABASE_URL=mysql://user:password@host:3306/longseason

# Must match user_service access token signing secret.
ACCESS_TOKEN_SECRET=longseason-dev-access-token-secret

# Optional. When configured, article creation calls ai_service.
AI_SERVICE_URL=http://127.0.0.1:3004
AI_INTERNAL_TOKEN=longseason-dev-ai-internal-token
AI_SERVICE_TIMEOUT_MS=5000
AI_ANALYSIS_ON_CREATE=true
