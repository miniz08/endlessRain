PORT=3004
DATABASE_URL=mysql://user:password@host:3306/longseason

# Must match user_service/api_gateway so admin cookies can access protected analysis APIs.
ACCESS_TOKEN_SECRET=longseason-dev-access-token-secret
JWT_SECRET=longseason-dev-access-token-secret

# Must match blog_service. Used for internal article-analysis calls.
AI_INTERNAL_TOKEN=longseason-dev-ai-internal-token

# mock is stable for defense/demo. Use openai-compatible for real model calls.
AI_PROVIDER=mock

# Legacy single-provider OpenAI-compatible config.
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_CHAT_PATH=/chat/completions
AI_API_KEY=replace-with-your-api-key
AI_MODEL=Qwen/Qwen2-7B-Instruct

AI_TIMEOUT_MS=20000
AI_RETRY_COUNT=1

# Optional multi-provider round-robin config for real model validation.
# Fill any provider keys you own, then set AI_PROVIDER=openai-compatible.
# Targets with missing keys are skipped automatically.
SILICONFLOW_API_KEY=replace-with-your-siliconflow-key
ZHIPU_API_KEY=replace-with-your-zhipu-key
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
QIANFAN_API_KEY=replace-with-your-qianfan-key
AI_PROVIDER_TARGETS='[{"id":"siliconflow-free","baseUrl":"https://api.siliconflow.cn/v1","chatPath":"/chat/completions","apiKeyEnv":"SILICONFLOW_API_KEY","models":["Qwen/Qwen2-7B-Instruct","THUDM/glm-4-9b-chat","internlm/internlm2_5-7b-chat"]},{"id":"zhipu-free","baseUrl":"https://open.bigmodel.cn/api/paas/v4","chatPath":"/chat/completions","apiKeyEnv":"ZHIPU_API_KEY","models":["glm-4.7-flash"]},{"id":"dashscope-free-quota","baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","chatPath":"/chat/completions","apiKeyEnv":"DASHSCOPE_API_KEY","models":["qwen-turbo","qwen-plus"]},{"id":"qianfan-free-quota","baseUrl":"https://qianfan.baidubce.com/v2","chatPath":"/chat/completions","apiKeyEnv":"QIANFAN_API_KEY","models":["ernie-4.5-turbo-32k","ernie-x1-turbo-32k"]}]'
