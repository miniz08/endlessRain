# Longseason AI social platform local Docker environment.
# This file is ignored by Git. It is meant for development and defense deployment.

# Shared MySQL database for all services.
DATABASE_URL="mysql://longseason:SuijoYuki514@106.52.220.73:3306/longseason"

# Development tokens. Plaintext is acceptable for this project stage.
# Change these before a public production deployment.
ACCESS_TOKEN_SECRET="longseason-dev-access-token-secret"
JWT_SECRET="longseason-dev-access-token-secret"
AI_INTERNAL_TOKEN="longseason-dev-ai-internal-token"

# Internal Docker service URLs.
USER_SERVICE_URL="http://user_service:3003"
BLOG_SERVICE_URL="http://blog_service:3002"
AI_SERVICE_URL="http://ai_service:3004"
CHAT_SERVICE_URL="http://chat_service:3005"

# AI provider.
# mock keeps the system deterministic and requires no paid key.
# To use a real model, set AI_PROVIDER="openai-compatible" and fill AI_API_KEY.
AI_PROVIDER="openai-compatible"
AI_BASE_URL="https://api.siliconflow.cn/v1"
AI_CHAT_PATH="/chat/completions"
AI_API_KEY=""
AI_MODEL="Qwen/Qwen2-7B-Instruct"
AI_TIMEOUT_MS=20000
AI_RETRY_COUNT=1
AI_ANALYSIS_ON_CREATE="true"

# Optional multi-provider round-robin config for real model validation.
# Fill any provider keys you own, then set AI_PROVIDER="openai-compatible".
# Targets with missing keys are skipped automatically.
SILICONFLOW_API_KEY="sk-qxshkmpoxzgwytcjyzssrbzsckimuugzsyflmajgqszyjfmu"
ZHIPU_API_KEY="95c5785d4c7b457cbbab4d8b54b91cae.XM31xSU72rCIn7RM"
DASHSCOPE_API_KEY="sk-5d6cf0d27ca24d378532f4054a28e6fe"
QIANFAN_API_KEY="bce-v3/ALTAK-tlzZa8n68rPGAA1TOMIwM/29e41a2784cfd8abef86b752f13b064d4a352dde"
AI_PROVIDER_TARGETS='[{"id":"siliconflow-free","baseUrl":"https://api.siliconflow.cn/v1","chatPath":"/chat/completions","apiKeyEnv":"SILICONFLOW_API_KEY","models":["Qwen/Qwen2-7B-Instruct","THUDM/glm-4-9b-chat","internlm/internlm2_5-7b-chat"]},{"id":"zhipu-free","baseUrl":"https://open.bigmodel.cn/api/paas/v4","chatPath":"/chat/completions","apiKeyEnv":"ZHIPU_API_KEY","models":["glm-4.7-flash"]},{"id":"dashscope-free-quota","baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","chatPath":"/chat/completions","apiKeyEnv":"DASHSCOPE_API_KEY","models":["qwen-turbo","qwen-plus"]},{"id":"qianfan-free-quota","baseUrl":"https://qianfan.baidubce.com/v2","chatPath":"/chat/completions","apiKeyEnv":"QIANFAN_API_KEY","models":["ernie-4.5-turbo-32k","ernie-x1-turbo-32k"]}]'

# Frontend runtime paths.
NUXT_PUBLIC_API_BASE="/api"
NUXT_PUBLIC_WS_BASE=""

# Production host port. Container frontend still listens on 80.
FRONTEND_HTTP_PORT=800

# Docker development host ports. These avoid your existing blog containers.
DEV_FRONTEND_PORT=13000
DEV_GATEWAY_PORT=13001
DEV_BLOG_PORT=13002
DEV_USER_PORT=13003
DEV_AI_PORT=13004
DEV_CHAT_PORT=13005
