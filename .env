# Longseason AI social platform local Docker environment.
# This file is ignored by Git. It is meant for development and defense deployment.

# Shared MySQL database for all services.
DATABASE_URL="mysql://longseason:SuijoYuki514@106.52.220.73:3306/longseason"

# Development tokens. Plaintext is acceptable for this project stage.
# Change these before a public production deployment.
ACCESS_TOKEN_SECRET="longseason-dev-access-token-secret"
JWT_SECRET="longseason-dev-access-token-secret"
AI_INTERNAL_TOKEN="longseason-dev-ai-internal-token"

# Internal Docker service URLs.
USER_SERVICE_URL="http://user_service:3003"
BLOG_SERVICE_URL="http://blog_service:3002"
AI_SERVICE_URL="http://ai_service:3004"
CHAT_SERVICE_URL="http://chat_service:3005"

# AI provider.
# mock keeps the system deterministic and requires no paid key.
# To use a real model, set AI_PROVIDER="openai-compatible" and fill AI_API_KEY.
AI_PROVIDER="mock"
AI_BASE_URL="https://api.siliconflow.cn/v1"
AI_CHAT_PATH="/chat/completions"
AI_API_KEY=""
AI_MODEL="Qwen/QwQ-32B"
AI_TIMEOUT_MS=20000
AI_RETRY_COUNT=1
AI_ANALYSIS_ON_CREATE="true"

# Frontend runtime paths.
NUXT_PUBLIC_API_BASE="/api"
NUXT_PUBLIC_WS_BASE=""

# Production host port. Container frontend still listens on 80.
FRONTEND_HTTP_PORT=800

# Docker development host ports. These avoid your existing blog containers.
DEV_FRONTEND_PORT=13000
DEV_GATEWAY_PORT=13001
DEV_BLOG_PORT=13002
DEV_USER_PORT=13003
DEV_AI_PORT=13004
DEV_CHAT_PORT=13005
